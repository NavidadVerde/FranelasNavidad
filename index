    /**
     * CONVERSIÓN DE ENLACES DE GOOGLE DRIVE Y PARSEO CSV DE GOOGLE SHEETS
     */
    function normalizeImageUrl(rawUrl) {
      const url = (rawUrl || '').trim();
      if (!url) return { primary: '', fallback: '' };

      // Detectar ID de archivo en enlaces de Google Drive
      const driveMatch = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
      if (driveMatch && driveMatch[1]) {
        const fileId = driveMatch[1];
        return {
          primary: `https://lh3.googleusercontent.com/d/${fileId}=w800`,
          fallback: `https://drive.google.com/thumbnail?id=${fileId}&sz=w800`
        };
      }
      return { primary: url, fallback: '' };
    }

    function normalizeUbicacion(raw) {
      const val = (raw || '').trim().toLowerCase();
      const map = {
        'bottom-left': 'Abajo izquierda',
        'abajo izquierda': 'Abajo izquierda',
        'bottom-right': 'Abajo derecha',
        'abajo derecha': 'Abajo derecha',
        'bottom-center': 'Abajo derecha',
        'chest-left': 'Pecho izquierdo',
        'pecho izquierdo': 'Pecho izquierdo',
        'center': 'Centro pecho',
        'centro pecho': 'Centro pecho',
        'side-left': 'Borde lateral',
        'borde lateral': 'Borde lateral'
      };
      return map[val] || 'Abajo izquierda';
    }

    function normalizeFamily(raw) {
      const val = (raw || '').trim().toLowerCase();
      if (val.startsWith('asom')) return 'Asomados';
      if (val.startsWith('clas') || val.startsWith('clás')) return 'Clásicos ilustrados';
      if (val.startsWith('tier')) return 'Tiernos';
      return 'Asomados';
    }

    function parseCSV(text) {
      const rows = [];
      let row = [];
      let field = '';
      let inQuotes = false;

      for (let i = 0; i < text.length; i++) {
        const c = text[i];
        const next = text[i + 1];
        if (inQuotes) {
          if (c === '"' && next === '"') {
            field += '"';
            i++;
          } else if (c === '"') {
            inQuotes = false;
          } else {
            field += c;
          }
        } else {
          if (c === '"') {
            inQuotes = true;
          } else if (c === ',') {
            row.push(field);
            field = '';
          } else if (c === '\n' || (c === '\r' && next === '\n')) {
            if (c === '\r') i++;
            row.push(field);
            rows.push(row);
            row = [];
            field = '';
          } else if (c !== '\r') {
            field += c;
          }
        }
      }
      if (field.length > 0 || row.length > 0) {
        row.push(field);
        rows.push(row);
      }
      return rows;
    }

    async function loadCatalogFromGoogleSheets(urlToFetch) {
      const targetUrl = (urlToFetch || state.sheetsUrl || DEFAULT_GOOGLE_SHEETS_CSV_URL).trim();
      const badge = document.getElementById('sheets-live-badge');
      const statusEl = document.getElementById('sheets-status-text');

      try {
        if (badge) {
          badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> Sincronizando...`;
        }
        const sep = targetUrl.includes('?') ? '&' : '?';
        const res = await fetch(`${targetUrl}${sep}_t=${Date.now()}`, { cache: 'no-store' });
        if (!res.ok) throw new Error('No se pudo leer la hoja');

        const csvText = await res.text();
        const rows = parseCSV(csvText);
        if (rows.length < 2) throw new Error('Hoja vacía');

        const headers = rows[0].map(h => h.trim().toLowerCase());
        const idxCode = headers.indexOf('codigo');
        const idxName = headers.indexOf('nombre');
        const idxFam = headers.indexOf('familia');
        const idxPos = headers.indexOf('ubicacion');
        const idxPrice = headers.indexOf('precio');
        const idxActive = headers.indexOf('activo');
        const idxImg = headers.indexOf('imagen_url');

        const mergedMap = new Map(BASE_CATALOG_ITEMS.map(item => [item.code, { ...item }]));
        let loadedPhotosCount = 0;

        for (let i = 1; i < rows.length; i++) {
          const r = rows[i];
          const code = (r[idxCode] || '').trim().toUpperCase();
          if (!code) continue;

          const activeVal = idxActive >= 0 ? (r[idxActive] || 'Si').trim().toLowerCase() : 'si';
          if (activeVal === 'no' || activeVal === 'false' || activeVal === '0') {
            mergedMap.delete(code);
            continue;
          }

          const existing = mergedMap.get(code) || {
            code,
            name: code,
            family: 'Asomados',
            defaultPos: 'Abajo izquierda',
            price: DEFAULT_UNIT_PRICE,
            imageUrl: ''
          };

          const rawImg = idxImg >= 0 ? (r[idxImg] || '').trim() : '';
          if (rawImg) loadedPhotosCount++;

          const parsedPrice = idxPrice >= 0 ? parseFloat((r[idxPrice] || '').replace(/[^0-9.]/g, '')) : NaN;

          mergedMap.set(code, {
            code,
            name: idxName >= 0 && r[idxName]?.trim() ? r[idxName].trim() : existing.name,
            family: idxFam >= 0 && r[idxFam]?.trim() ? normalizeFamily(r[idxFam]) : existing.family,
            defaultPos: idxPos >= 0 && r[idxPos]?.trim() ? normalizeUbicacion(r[idxPos]) : existing.defaultPos,
            price: !isNaN(parsedPrice) && parsedPrice > 0 ? parsedPrice : existing.price,
            imageUrl: rawImg || existing.imageUrl
          });
        }

        CATALOG_ITEMS = Array.from(mergedMap.values());
        updateFamilyCountsUI();

        if (badge) {
          badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-pine"></span> Sheets (${loadedPhotosCount} fotos)`;
        }
        if (statusEl) {
          statusEl.textContent = `Conectado correctamente: ${CATALOG_ITEMS.length} diseños activos y ${loadedPhotosCount} fotos cargadas desde Google Sheets.`;
        }
      } catch (err) {
        CATALOG_ITEMS = [...BASE_CATALOG_ITEMS];
        updateFamilyCountsUI();
        if (badge) {
          badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Catálogo local`;
        }
        if (statusEl) {
          statusEl.textContent = 'Mostrando respaldo local. Verifica que la hoja esté publicada como CSV.';
        }
      }

      renderOnboardingMotifsGrid();
      renderOnboardingPreview();
      renderCatalogGrid();
    }

