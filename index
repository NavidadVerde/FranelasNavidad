      const filtered = CATALOG_ITEMS.filter(item => {
        const matchesFamily = state.familyFilter === 'ALL' || item.family === state.familyFilter;
        const matchesSearch =
          !state.searchQuery ||
          item.code.toLowerCase().includes(state.searchQuery) ||
          item.name.toLowerCase().includes(state.searchQuery) ||
          item.family.toLowerCase().includes(state.searchQuery);
        return matchesFamily && matchesSearch;
      });

      document.getElementById('catalog-count').textContent = filtered.length;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
