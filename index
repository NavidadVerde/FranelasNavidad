<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#C81E1E">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>Viste el Espíritu de la Navidad | Franelas Navideñas para Niños</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Fraunces', 'Georgia', 'serif'],
            fun: ['Fredoka', 'cursive', 'sans-serif'],
          },
          colors: {
            cream: '#FAF8F5',
            crimson: {
              DEFAULT: '#B91C1C',
              dark: '#991B1B',
            },
            pine: {
              DEFAULT: '#15803D',
              dark: '#166534',
            },
            gold: {
              DEFAULT: '#D97706',
              light: '#F59E0B',
            }
          }
        }
      }
    }
  </script>
  <style>
    html, body {
      max-width: 100%;
      overflow-x: hidden;
      background-color: #F5F4F0;
      color: #1C1917;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
      -webkit-text-size-adjust: 100%;
    }
    .safe-top {
      padding-top: env(safe-area-inset-top, 0px);
    }
    .safe-bottom {
      padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    }
    .dvh-full {
      height: 100vh;
      height: 100dvh;
    }
    .dvh-modal {
      max-height: 92vh;
      max-height: 92dvh;
    }
    .shirt-drop {
      filter: drop-shadow(0 10px 16px rgba(28, 25, 23, 0.14));
    }
    .no-scrollbar {
      -webkit-overflow-scrolling: touch;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .touch-scroll {
      -webkit-overflow-scrolling: touch;
    }
    /* Evita auto-zoom en iPhone Safari (inputs >= 16px en móvil) */
    @media (max-width: 767px) {
      input[type="text"], input[type="url"], select, textarea {
        font-size: 16px !important;
      }
    }
  </style>
</head>
<body class="antialiased selection:bg-crimson selection:text-white">

  <!-- 1. Cabecera Limpia y Compacta (iOS Notch + Android Friendly) -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200/90 safe-top">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 min-h-[60px] py-1.5 flex items-center justify-between gap-2 sm:gap-4">
      <!-- Marca -->
      <a href="#" class="flex items-center gap-2 shrink-0 min-h-[44px]">
        <div class="w-9 h-9 rounded-xl bg-crimson text-white flex items-center justify-center shadow-xs shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L9 8h2l-3 5h2.5L7 19h10l-3.5-6H16l-3-5h2L12 2zm-1.5 18h3v2h-3v-2z"/>
          </svg>
        </div>
        <div class="leading-none">
          <span class="font-display font-extrabold text-[13px] sm:text-base text-stone-900 block">Viste el Espíritu</span>
          <span class="text-[10px] sm:text-[11px] font-bold text-crimson tracking-wide">DE LA NAVIDAD</span>
        </div>
      </a>

      <!-- Buscador Rápido (Desktop) -->
      <div class="hidden md:block flex-1 max-w-sm">
        <div class="relative">
          <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
          </svg>
          <input
            type="text"
            id="search-input-desktop"
            oninput="handleSearch(this.value)"
            placeholder="Buscar código o motivo (A05, Renito, Santa)..."
            class="w-full pl-9 pr-4 py-2 rounded-full border border-stone-200 bg-canvas/80 focus:bg-white text-xs font-medium text-stone-800 placeholder-stone-400 focus:outline-none focus:border-crimson transition"
          >
        </div>
      </div>

      <!-- Controles Globales: Switch Blanca/Roja + Carrito (Touch >= 44px) -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Switch Global Color -->
        <div class="inline-flex items-center p-1 rounded-full bg-canvas border border-stone-200">
          <button
            type="button"
            onclick="setGlobalColor('white')"
            id="global-btn-white"
            class="flex items-center gap-1 px-2.5 min-h-[36px] rounded-full text-xs font-bold bg-white text-stone-900 shadow-xs transition cursor-pointer"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-white border border-stone-300"></span>
            <span>Blanca</span>
          </button>
          <button
            type="button"
            onclick="setGlobalColor('red')"
            id="global-btn-red"
            class="flex items-center gap-1 px-2.5 min-h-[36px] rounded-full text-xs font-semibold text-stone-600 hover:text-stone-900 transition cursor-pointer"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-crimson"></span>
            <span>Roja</span>
          </button>
        </div>

        <!-- Botón Carrito -->
        <button
          type="button"
          onclick="toggleCartDrawer(true)"
          aria-label="Abrir carrito"
          class="relative inline-flex items-center justify-center gap-1.5 px-3 sm:px-3.5 min-h-[44px] rounded-full bg-stone-900 hover:bg-crimson active:scale-95 text-white text-xs font-bold shadow-xs transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="hidden sm:inline">Carrito</span>
          <span id="cart-badge" class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-amber-400 text-stone-950 font-extrabold text-[11px]">0</span>
        </button>
      </div>
    </div>

    <!-- Buscador Móvil (16px para evitar auto-zoom en iPhone Safari) -->
    <div class="md:hidden px-3 pb-2.5">
      <div class="relative">
        <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
        </svg>
        <input
          type="text"
          id="search-input-mobile"
          oninput="handleSearch(this.value)"
          placeholder="Buscar código o motivo (A05, Renito)..."
          class="w-full pl-9 pr-4 py-2 min-h-[42px] rounded-full border border-stone-200 bg-canvas text-base font-medium text-stone-800 placeholder-stone-400 focus:outline-none focus:border-crimson"
        >
      </div>
    </div>
  </header>

  <!-- 2. Banner Principal Superior -->
  <section class="relative overflow-hidden bg-gradient-to-br from-crimson via-crimson-dark to-stone-900 text-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-7 sm:py-11 flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-amber-300 text-xs font-bold tracking-wide mb-2.5">
          🎄 Colección Oficial · <span id="hero-total-count">52</span> Motivos Exclusivos
        </span>
        <h1 class="font-display font-extrabold text-2xl sm:text-4xl lg:text-5xl leading-tight tracking-tight">
          Franelas navideñas para niños
        </h1>
        <p class="mt-1.5 text-xs sm:text-base text-red-100 font-medium">
          Tallas 4 a 16 · $15 c/u · Personalízala a tu gusto
        </p>
      </div>

      <div class="grid grid-cols-2 sm:flex items-center gap-2.5 w-full sm:w-auto shrink-0">
        <a href="#onboarding-designer" class="min-h-[46px] px-4 sm:px-5 py-3 rounded-full bg-amber-400 hover:bg-amber-300 active:scale-95 text-stone-950 font-extrabold text-xs sm:text-sm shadow-lg flex items-center justify-center text-center transition">
          🎨 Diseñar franela
        </a>
        <a href="#catalogo-section" class="min-h-[46px] px-4 sm:px-5 py-3 rounded-full bg-white/15 hover:bg-white/25 active:scale-95 text-white font-bold text-xs sm:text-sm border border-white/25 flex items-center justify-center text-center transition">
          Ver catálogo
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Estudio Interactivo de Personalización (Onboarding en 5 pasos) -->
  <section id="onboarding-designer" class="max-w-7xl mx-auto px-3 sm:px-6 pt-5 sm:pt-8">
    <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm overflow-hidden">
      <!-- Barra Superior de Pasos -->
      <div class="px-4 sm:px-6 py-3.5 sm:py-4 bg-canvas/80 border-b border-stone-200/80 flex flex-col lg:flex-row lg:items-center justify-between gap-2.5">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider text-crimson">Estudio Interactivo</span>
            <h2 class="font-display font-extrabold text-base sm:text-xl text-stone-900">
              Personaliza tu franela en 5 pasos
            </h2>
          </div>
          <span id="ob-mobile-step-indicator" class="lg:hidden px-2.5 py-1 rounded-full bg-crimson/10 text-crimson font-extrabold text-[11px]">Paso 1/5</span>
        </div>

        <!-- Pestañas Rápidas de Pasos (Deslizables con Touch en iOS/Android) -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <button type="button" onclick="setOnboardingStep(1)" data-step="1" class="ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-bold bg-crimson text-white whitespace-nowrap transition cursor-pointer">
            1. Color
          </button>
          <button type="button" onclick="setOnboardingStep(2)" data-step="2" class="ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-stone-600 border border-stone-200 whitespace-nowrap transition cursor-pointer">
            2. Motivo
          </button>
          <button type="button" onclick="setOnboardingStep(3)" data-step="3" class="ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-stone-600 border border-stone-200 whitespace-nowrap transition cursor-pointer">
            3. Ubicación
          </button>
          <button type="button" onclick="setOnboardingStep(4)" data-step="4" class="ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-stone-600 border border-stone-200 whitespace-nowrap transition cursor-pointer">
            4. Nombre
          </button>
          <button type="button" onclick="setOnboardingStep(5)" data-step="5" class="ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-stone-600 border border-stone-200 whitespace-nowrap transition cursor-pointer">
            5. Talla y Agregar
          </button>
        </div>
      </div>

      <!-- Cuerpo del Estudio: Vista Previa Adaptable + Controles -->
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Panel Izquierdo: Maqueta Compacta en Móvil / Gigante en Desktop -->
        <div class="lg:col-span-5 bg-canvas/60 px-4 py-3.5 sm:p-7 flex flex-col items-center justify-center border-b lg:border-b-0 lg:border-r border-stone-200/80">
          <div class="w-full flex items-center justify-between gap-2 text-xs mb-1.5">
            <span id="ob-badge-code" class="px-2.5 py-0.5 rounded-lg bg-stone-900 text-white font-mono font-bold shrink-0">A01</span>
            <span id="ob-badge-summary" class="px-2.5 py-0.5 rounded-full bg-white border border-stone-200 font-semibold text-stone-600 truncate">
              Blanca · Talla 8 · Sugerida
            </span>
          </div>

          <div id="ob-live-mockup" class="w-44 h-48 sm:w-full sm:max-w-[300px] sm:h-72 lg:h-80 flex items-center justify-center">
            <!-- SVG / Imagen real renderizada por JS -->
          </div>

          <div class="mt-1.5 flex items-center gap-2 text-xs text-stone-600 font-medium text-center">
            <span id="ob-motif-label" class="font-bold text-stone-900 truncate max-w-[200px] sm:max-w-none">Asomado en la esquina</span>
            <span>·</span>
            <span id="ob-motif-price" class="font-display font-extrabold text-crimson text-base">$15</span>
          </div>
        </div>

        <!-- Panel Derecho: Pasos Guiados -->
        <div class="lg:col-span-7 p-4 sm:p-7 flex flex-col justify-between min-h-[310px] sm:min-h-[360px]">
          <!-- PASO 1: COLOR -->
          <div id="ob-panel-1" class="ob-panel space-y-3.5">
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-crimson">Paso 1 de 5</span>
              <h3 class="font-display font-bold text-lg sm:text-xl text-stone-900 mt-0.5">Elige el color de la franela</h3>
              <p class="text-xs text-stone-500 mt-1">Todos los motivos están disponibles en franela blanca o roja de algodón suave.</p>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:gap-4 pt-1">
              <button type="button" onclick="setOnboardingColor('white')" id="ob-color-white" class="min-h-[112px] p-4 sm:p-5 rounded-2xl border-2 border-crimson bg-red-50/30 flex flex-col items-center justify-center gap-2.5 active:scale-95 transition cursor-pointer">
                <span class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white border-2 border-stone-300 shadow-xs"></span>
                <span class="font-bold text-xs sm:text-sm text-stone-900">Franela Blanca</span>
              </button>
              <button type="button" onclick="setOnboardingColor('red')" id="ob-color-red" class="min-h-[112px] p-4 sm:p-5 rounded-2xl border border-stone-200 hover:border-stone-300 bg-white flex flex-col items-center justify-center gap-2.5 active:scale-95 transition cursor-pointer">
                <span class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-crimson shadow-xs"></span>
                <span class="font-bold text-xs sm:text-sm text-stone-800">Franela Roja</span>
              </button>
            </div>
          </div>

          <!-- PASO 2: MOTIVO -->
          <div id="ob-panel-2" class="ob-panel hidden space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-crimson">Paso 2 de 5</span>
                <h3 class="font-display font-bold text-lg sm:text-xl text-stone-900 mt-0.5">Elige el motivo navideño</h3>
              </div>
              <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
                <button type="button" onclick="setOnboardingFamily('Asomados')" data-obfam="Asomados" class="ob-fam-btn min-h-[34px] px-3 py-1 rounded-full text-xs font-bold bg-stone-900 text-white whitespace-nowrap cursor-pointer">Asomados</button>
                <button type="button" onclick="setOnboardingFamily('Clásicos ilustrados')" data-obfam="Clásicos ilustrados" class="ob-fam-btn min-h-[34px] px-3 py-1 rounded-full text-xs font-semibold bg-canvas text-stone-700 border border-stone-200 whitespace-nowrap cursor-pointer">Clásicos</button>
                <button type="button" onclick="setOnboardingFamily('Tiernos')" data-obfam="Tiernos" class="ob-fam-btn min-h-[34px] px-3 py-1 rounded-full text-xs font-semibold bg-canvas text-stone-700 border border-stone-200 whitespace-nowrap cursor-pointer">Tiernos</button>
              </div>
            </div>

            <div id="ob-motifs-grid" class="grid grid-cols-4 sm:grid-cols-6 gap-2 max-h-52 sm:max-h-56 overflow-y-auto touch-scroll pr-1">
              <!-- Miniaturas dinámicas -->
            </div>
          </div>

          <!-- PASO 3: UBICACIÓN -->
          <div id="ob-panel-3" class="ob-panel hidden space-y-3.5">
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-crimson">Paso 3 de 5</span>
              <h3 class="font-display font-bold text-lg sm:text-xl text-stone-900 mt-0.5">Ubicación del estampado</h3>
              <p class="text-xs text-stone-500 mt-1">Usa la ubicación sugerida del catálogo o elige dónde prefieres el diseño.</p>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="ob-placement-grid">
              <!-- Opciones renderizadas por JS -->
            </div>
          </div>

          <!-- PASO 4: NOMBRE DEL NIÑO/A (OPCIONAL) -->
          <div id="ob-panel-4" class="ob-panel hidden space-y-3.5">
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-crimson">Paso 4 de 5 · Opcional</span>
              <h3 class="font-display font-bold text-lg sm:text-xl text-stone-900 mt-0.5">Personalizar con el nombre del niño/a</h3>
            </div>

            <div class="space-y-3">
              <div class="relative">
                <input
                  type="text"
                  id="ob-kid-name"
                  maxlength="16"
                  oninput="updateOnboardingName(this.value)"
                  placeholder="Ej: Mateo, Sofía, Lucas..."
                  class="w-full pl-4 pr-16 py-2.5 min-h-[46px] rounded-2xl border border-stone-300 bg-canvas focus:bg-white text-base sm:text-sm font-semibold text-stone-900 placeholder-stone-400 focus:outline-none focus:border-crimson transition"
                >
                <button type="button" onclick="clearOnboardingName()" class="absolute right-2 top-1/2 -translate-y-1/2 min-h-[36px] px-2.5 text-xs font-bold text-stone-500 hover:text-crimson cursor-pointer">Limpiar</button>
              </div>

              <!-- Selector de posición y estilo del nombre -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1.5">Posición del nombre</span>
                  <div class="grid grid-cols-2 gap-1.5">
                    <button type="button" onclick="setOnboardingNamePos('top')" id="ob-namepos-top" class="min-h-[40px] py-2 px-3 rounded-xl text-xs font-bold bg-stone-900 text-white cursor-pointer">Arriba (Pecho)</button>
                    <button type="button" onclick="setOnboardingNamePos('bottom')" id="ob-namepos-bottom" class="min-h-[40px] py-2 px-3 rounded-xl text-xs font-semibold bg-canvas text-stone-700 hover:bg-stone-200 cursor-pointer">Abajo (Borde)</button>
                  </div>
                </div>
                <div>
                  <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1.5">Estilo tipográfico</span>
                  <div class="grid grid-cols-2 gap-1.5">
                    <button type="button" onclick="setOnboardingNameStyle('classic')" id="ob-namestyle-classic" class="min-h-[40px] py-2 px-3 rounded-xl text-xs font-bold bg-stone-900 text-white cursor-pointer">Clásico Festivo</button>
                    <button type="button" onclick="setOnboardingNameStyle('modern')" id="ob-namestyle-modern" class="min-h-[40px] py-2 px-3 rounded-xl text-xs font-semibold bg-canvas text-stone-700 hover:bg-stone-200 cursor-pointer">Moderno Bold</button>
                  </div>
                </div>
              </div>

              <!-- Ejemplos rápidos -->
              <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                <span class="text-[11px] text-stone-400 font-medium">Probar:</span>
                <button type="button" onclick="quickFillOnboardingName('Mateo')" class="min-h-[34px] px-3 py-1 rounded-full bg-canvas hover:bg-stone-200 text-xs font-semibold text-stone-700 cursor-pointer">Mateo</button>
                <button type="button" onclick="quickFillOnboardingName('Sofía')" class="min-h-[34px] px-3 py-1 rounded-full bg-canvas hover:bg-stone-200 text-xs font-semibold text-stone-700 cursor-pointer">Sofía</button>
                <button type="button" onclick="quickFillOnboardingName('Lucas')" class="min-h-[34px] px-3 py-1 rounded-full bg-canvas hover:bg-stone-200 text-xs font-semibold text-stone-700 cursor-pointer">Lucas</button>
                <button type="button" onclick="clearOnboardingName()" class="min-h-[34px] px-3 py-1 rounded-full bg-canvas hover:bg-stone-200 text-xs font-semibold text-stone-500 cursor-pointer">Sin nombre</button>
              </div>
            </div>
          </div>

          <!-- PASO 5: TALLA Y AGREGAR AL CARRITO -->
          <div id="ob-panel-5" class="ob-panel hidden space-y-3.5">
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-crimson">Paso 5 de 5</span>
              <h3 class="font-display font-bold text-lg sm:text-xl text-stone-900 mt-0.5">Elige la talla infantil (4 a 16)</h3>
            </div>

            <div class="grid grid-cols-7 gap-1.5 sm:gap-2" id="ob-sizes-grid">
              <!-- Tallas 4 a 16 -->
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
              <div class="flex items-center justify-between sm:justify-center border border-stone-300 rounded-2xl bg-canvas">
                <button type="button" onclick="changeOnboardingQty(-1)" class="min-w-[48px] min-h-[46px] font-bold text-base text-stone-700 hover:bg-stone-200 rounded-l-2xl cursor-pointer">−</button>
                <span id="ob-qty" class="px-5 font-extrabold text-sm">1</span>
                <button type="button" onclick="changeOnboardingQty(1)" class="min-w-[48px] min-h-[46px] font-bold text-base text-stone-700 hover:bg-stone-200 rounded-r-2xl cursor-pointer">+</button>
              </div>
              <button type="button" onclick="addOnboardingToCart()" class="flex-1 min-h-[48px] py-3.5 px-5 rounded-2xl bg-crimson hover:bg-crimson-dark active:scale-95 text-white font-extrabold text-sm shadow-md transition cursor-pointer">
                Agregar al carrito (<span id="ob-btn-total">$15</span>)
              </button>
            </div>
          </div>

          <!-- Pie de Navegación del Onboarding (Botones táctiles >= 44px) -->
          <div class="pt-4 mt-4 border-t border-stone-100 flex items-center justify-between gap-2">
            <button type="button" id="ob-prev-btn" onclick="prevOnboardingStep()" class="min-h-[44px] px-4 py-2 rounded-full border border-stone-200 text-xs font-bold text-stone-600 hover:bg-stone-100 disabled:opacity-40 cursor-pointer">
              ← Anterior
            </button>
