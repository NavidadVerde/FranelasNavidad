    /**
     * Renderiza la franela realista (Blanca o Roja) con foto real de Google Sheets o respaldo SVG + nombre del niño/a
     */
    function renderShirtMockup(item, color = 'white', customPlacement = 'Sugerida', kidName = '', nameOptions = {}) {
      const isRed = color === 'red';
      const shirtFill = isRed ? '#C81E1E' : '#FFFFFF';
      const shirtStroke = isRed ? '#991B1B' : '#E5E7EB';
      const collarFill = isRed ? '#7F1D1D' : '#F3F4F6';

      const effectivePos = (customPlacement === 'Sugerida' || !customPlacement) ? item.defaultPos : customPlacement;
      const transformStr = getPlacementTransform(effectivePos);
      const artworkVector = getMotifVectorSVG(item);

      const { primary, fallback } = normalizeImageUrl(item.imageUrl);
      let printLayerSVG = `<g transform="${transformStr}">${artworkVector}</g>`;

      if (primary) {
        const box = getImageBoxCoords(effectivePos);
        const uid = `art-${item.code}-${Math.random().toString(36).slice(2, 7)}`;
        const onErrHandler = fallback
          ? `if(!this.dataset.triedFallback){this.dataset.triedFallback='1';this.setAttribute('href','${fallback}');}else{this.style.display='none';document.getElementById('${uid}-fb').style.display='inline';}`
          : `this.style.display='none';document.getElementById('${uid}-fb').style.display='inline';`;

        printLayerSVG = `
          <g id="${uid}-fb" style="display:none" transform="${transformStr}">${artworkVector}</g>
          <image
            href="${escapeHTML(primary)}"
            x="${box.x}"
            y="${box.y}"
            width="${box.w}"
            height="${box.h}"
            preserveAspectRatio="xMidYMid meet"
            onerror="${onErrHandler}"
          />
        `;
      }

      const cleanName = (kidName || '').trim();
      let nameSVG = '';
      if (cleanName) {
        const posPref = nameOptions.pos || 'top';
        const stylePref = nameOptions.style || 'classic';

        let nameY = posPref === 'bottom' ? 216 : 64;
        if (posPref === 'top' && effectivePos === 'Centro pecho') nameY = 152;
        if (posPref === 'bottom' && (effectivePos === 'Abajo izquierda' || effectivePos === 'Abajo derecha')) nameY = 148;

        const textFill = isRed ? '#FDE68A' : '#B91C1C';
        const strokeColor = isRed ? '#7F1D1D' : '#FFFFFF';
        const fontFamily = stylePref === 'modern' ? 'Inter, sans-serif' : 'Fraunces, serif';
        const fontSize = cleanName.length > 11 ? 13 : (cleanName.length > 8 ? 15 : 17);

        nameSVG = `
          <g class="pointer-events-none">
            <text
              x="120"
              y="${nameY}"
              text-anchor="middle"
              font-family="${fontFamily}"
              font-weight="800"
              font-size="${fontSize}"
              letter-spacing="0.6"
              fill="${textFill}"
              stroke="${strokeColor}"
              stroke-width="2.5"
              paint-order="stroke"
            >${escapeHTML(cleanName)}</text>
          </g>
        `;
      }

      return `
        <svg viewBox="0 0 240 250" class="w-full h-full shirt-drop select-none">
          <!-- Silueta de la Franela -->
          <path
            d="M84 18
               C96 27, 144 27, 156 18
               L204 38
               L232 86
               L202 104
               L186 78
               L186 232
               C186 236, 182 238, 176 238
               L64 238
               C58 238, 54 236, 54 232
               L54 78
               L38 104
               L8 86
               L36 38
               Z"
            fill="${shirtFill}"
            stroke="${shirtStroke}"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          <!-- Cuello -->
          <path d="M84 18 C98 34, 142 34, 156 18 C142 24, 98 24, 84 18 Z" fill="${collarFill}" />
          <path d="M84 18 C98 36, 142 36, 156 18" fill="none" stroke="${shirtStroke}" stroke-width="2" />

          <!-- Estampado (Foto real o Vector SVG) -->
          ${printLayerSVG}

          <!-- Nombre del Niño/a (Opcional) -->
          ${nameSVG}
        </svg>
      `;
    }

    function escapeHTML(str) {
      return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    }

    /**
     * LÓGICA DEL ESTUDIO INTERACTIVO ONBOARDING (5 PASOS)
     */
    function setOnboardingStep(step) {
      state.obStep = Math.max(1, Math.min(5, step));

      const mobileIndicator = document.getElementById('ob-mobile-step-indicator');
      if (mobileIndicator) mobileIndicator.textContent = `Paso ${state.obStep}/5`;

      document.querySelectorAll('.ob-pill').forEach(btn => {
        const s = Number(btn.dataset.step);
        if (s === state.obStep) {
          btn.className = 'ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-bold bg-crimson text-white whitespace-nowrap transition cursor-pointer';
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else if (s < state.obStep) {
          btn.className = 'ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-bold bg-pine/10 text-pine border border-pine/20 whitespace-nowrap transition cursor-pointer';
        } else {
          btn.className = 'ob-pill min-h-[38px] px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-stone-600 border border-stone-200 whitespace-nowrap transition cursor-pointer';
        }
      });

      document.querySelectorAll('.ob-panel').forEach((panel, idx) => {
        panel.classList.toggle('hidden', idx + 1 !== state.obStep);
      });

      const dots = document.getElementById('ob-dots').children;
      for (let i = 0; i < dots.length; i++) {
        dots[i].className = i + 1 === state.obStep
          ? 'w-5 h-2 rounded-full bg-crimson transition-all'
          : 'w-2 h-2 rounded-full bg-stone-200 transition-all';
      }

      document.getElementById('ob-prev-btn').disabled = state.obStep === 1;
      document.getElementById('ob-next-btn').classList.toggle('hidden', state.obStep === 5);
    }

    function nextOnboardingStep() {
      if (state.obStep < 5) setOnboardingStep(state.obStep + 1);
    }

    function prevOnboardingStep() {
      if (state.obStep > 1) setOnboardingStep(state.obStep - 1);
    }

