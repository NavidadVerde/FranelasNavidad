    /**
     * CARRITO Y ENVÍO DIRECTO A WHATSAPP (+584242074584)
     */
    function toggleCartDrawer(open) {
      const drawer = document.getElementById('cart-drawer');
      const backdrop = document.getElementById('cart-backdrop');
      if (open) {
        backdrop.classList.remove('hidden');
        drawer.classList.remove('translate-x-full');
      } else {
        backdrop.classList.add('hidden');
        drawer.classList.add('translate-x-full');
      }
    }

    function pushItemToCart({ code, name, color, size, placement, kidName, price, qty }) {
      const colorLabel = color === 'red' ? 'roja' : 'blanca';
      const cleanKidName = (kidName || '').trim();
      const unitPrice = price || DEFAULT_UNIT_PRICE;

      const existing = state.cart.find(
        e => e.code === code &&
             e.color === color &&
             e.size === size &&
             e.placement === placement &&
             (e.kidName || '') === cleanKidName
      );

      if (existing) {
        existing.qty += qty;
      } else {
        state.cart.push({
          code,
          name,
          color,
          colorLabel,
          size,
          placement,
          kidName: cleanKidName,
          price: unitPrice,
          qty
        });
      }

      renderCart();
      const nameTag = cleanKidName ? ` · ${cleanKidName}` : '';
      showToast(`${code} ${colorLabel} talla ${size}${nameTag} agregada`);
    }

    function updateCartItemQty(idx, delta) {
      state.cart[idx].qty += delta;
      if (state.cart[idx].qty <= 0) state.cart.splice(idx, 1);
      renderCart();
    }

    function generateOrderText() {
      if (state.cart.length === 0) return 'Sin artículos aún.';
      const lines = state.cart.map(e => {
        const unitPrice = e.price || DEFAULT_UNIT_PRICE;
        const subtotal = e.qty * unitPrice;
        const namePart = e.kidName ? ` - Nombre: ${e.kidName}` : '';
        return `${e.qty}x ${e.code} franela ${e.colorLabel} talla ${e.size}${namePart} - Ubicación: ${e.placement} ($${subtotal})`;
      });
      const totalUnits = state.cart.reduce((s, i) => s + i.qty, 0);
      const grandTotal = state.cart.reduce((s, i) => s + i.qty * (i.price || DEFAULT_UNIT_PRICE), 0);
      return `Hola! Quiero hacer este pedido de Franelas Navideñas para Niños:\n\n${lines.join('\n')}\n\nTotal franelas: ${totalUnits}\nTotal a pagar: $${grandTotal}`;
    }

    function renderCart() {
      const container = document.getElementById('cart-items-container');
      const totalUnits = state.cart.reduce((s, i) => s + i.qty, 0);
      const grandTotal = state.cart.reduce((s, i) => s + i.qty * (i.price || DEFAULT_UNIT_PRICE), 0);

      document.getElementById('cart-badge').textContent = totalUnits;
      document.getElementById('cart-total-units').textContent = totalUnits;
      document.getElementById('cart-total-price').textContent = `$${grandTotal}`;
      document.getElementById('order-summary-preview').textContent = generateOrderText();

      if (state.cart.length === 0) {
        container.innerHTML = `<div class="h-full flex items-center justify-center text-xs text-stone-400">Tu carrito está vacío</div>`;
        return;
      }

      container.innerHTML = state.cart.map((entry, idx) => {
        const item = CATALOG_ITEMS.find(i => i.code === entry.code) || BASE_CATALOG_ITEMS[0];
        const unitPrice = entry.price || DEFAULT_UNIT_PRICE;
        return `
          <div class="bg-canvas rounded-2xl p-3 border border-stone-200 flex gap-3 items-center">
            <div class="w-16 h-16 bg-white rounded-xl border border-stone-200 p-1 shrink-0">
              ${renderShirtMockup(item, entry.color, entry.placement, entry.kidName)}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-extrabold text-stone-900 truncate">${entry.code} franela ${entry.colorLabel} talla ${entry.size}</p>
              <p class="text-[11px] text-stone-500 truncate">${entry.name} · ${entry.placement}</p>
              ${entry.kidName ? `<span class="inline-block mt-1 px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 text-[10px] font-bold">Nombre: ${escapeHTML(entry.kidName)}</span>` : ''}
              <div class="flex items-center justify-between mt-1.5">
                <div class="inline-flex items-center bg-white border border-stone-200 rounded-lg">
                  <button type="button" onclick="updateCartItemQty(${idx}, -1)" class="min-w-[34px] min-h-[34px] text-xs font-bold cursor-pointer">−</button>
                  <span class="px-2 text-xs font-bold">${entry.qty}</span>
                  <button type="button" onclick="updateCartItemQty(${idx}, 1)" class="min-w-[34px] min-h-[34px] text-xs font-bold cursor-pointer">+</button>
                </div>
                <span class="font-display font-bold text-sm text-crimson">$${entry.qty * unitPrice}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function copyOrderSummary() {
      if (state.cart.length === 0) {
        showToast('Agrega al menos una franela al carrito');
        return;
      }
      const textarea = document.createElement('textarea');
      textarea.value = generateOrderText();
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      showToast('Pedido copiado al portapapeles');
    }

    function sendWhatsAppOrder() {
      if (state.cart.length === 0) {
        showToast('Agrega al menos una franela al carrito');
        return;
      }
      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(generateOrderText())}`;
      window.open(url, '_blank', 'noopener');
    }

    let toastTimer = null;
    function showToast(msg) {
      const box = document.getElementById('toast-box');
      document.getElementById('toast-msg').textContent = msg;
      box.classList.remove('opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => box.classList.add('opacity-0'), 2400);
    }

    // Inicialización al cargar
    window.addEventListener('DOMContentLoaded', () => {
      renderOnboardingMotifsGrid();
      renderOnboardingPlacements();
      renderOnboardingSizes();
      renderOnboardingPreview();
      setOnboardingStep(1);
      renderCatalogGrid();
      renderCart();
      loadCatalogFromGoogleSheets(state.sheetsUrl);
    });
  </script>
</body>
</html>
